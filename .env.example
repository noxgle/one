# Copy to .env and fill in only the provider keys you need. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Set these to the owner of the pre-created docker-data directories.
ONE_UID=1000
ONE_GID=1000

# Create these directories before starting Compose.
ONE_CONFIG_DIR=./docker-data/config
ONE_WORKSPACE_DIR=./docker-data/workspace
