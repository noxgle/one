# Copy values into ignored landing_page/.env. No shell expansion or inline comments.
FTP_HOST=ftp.example.org
FTP_USER=YOUR_USERNAME
FTP_PASSWORD=YOUR_PASSWORD
FTP_DIR=/public_html
# Explicit FTPS (AUTH TLS); no downgrade. false permits insecure FTP deliberately.
FTP_TLS=true
# Opt in only for your trusted self-signed server; disables certificate/hostname checks.
FTP_ALLOW_SELF_SIGNED=false
PUBLIC_SITE_URL=https://example.org
DOCS_BASE=/docs/
